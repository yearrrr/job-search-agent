# Public template only. Copy to .env and enter the key locally.
JOB_AGENT_MODE=mock
JOB_AGENT_DATA_DIR=data
JOB_AGENT_PORT=8000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=40
MAX_TOOL_CALLS=60
# New business tasks only: retries for HTTP 429/500/503; each attempt uses the total budget.
# Timeouts, network errors and connectivity probes do not retry automatically.
MAX_RETRIES=1
MAX_INPUT_CHARS=100000
MAX_OUTPUT_TOKENS=102400
